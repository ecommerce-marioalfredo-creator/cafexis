# Se carga solo al compilar la web para producción (npm run build, Vercel);
# no en `npm run dev` ni en las apps móviles (la del equipo usa .env.equipo).
# Este archivo se sube al repositorio: aquí van solo banderas públicas, nunca
# llaves ni secretos.

# Muestra en /ingreso las cuentas de prueba con su contraseña, para quienes
# están probando el sistema. Borrar esta línea antes de recibir negocios
# reales: cualquiera podría entrar como soporte, que lee los datos de todos
# los negocios de esta base.
VITE_SHOW_DEMO_ACCOUNT=true
