# Se carga solo al compilar la app "Cafexis Equipo" (npm run mobile:equipo).
# Este archivo se sube al repositorio: aquí van solo banderas públicas, nunca
# llaves ni secretos.

# Muestra en el login las cuentas de prueba del negocio demo con su contraseña.
# Una app ya publicada en las tiendas no se apaga borrando esta línea: para
# cortar el acceso hay que cambiar esas contraseñas y sacar una versión nueva.
VITE_SHOW_DEMO_ACCOUNT=true
