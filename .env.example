# Credenciales del proyecto de Supabase (Project Settings → API en tu panel).
# La anon key es segura de exponer en el frontend: el acceso real está
# protegido por Row Level Security (ver supabase/migrations/0002_rls_cafexis.sql).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Opcional: muestra la cuenta demo (correo y contraseña) en /ingreso fuera de
# `npm run dev`. Úsalo solo en un entorno de demostración, nunca en el de
# negocios reales: esa cuenta es administradora del negocio demo.
# VITE_SHOW_DEMO_ACCOUNT=true
