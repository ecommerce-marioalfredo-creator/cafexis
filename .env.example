# Credenciales del proyecto de Supabase (Project Settings → API en tu panel).
# La anon key es segura de exponer en el frontend: el acceso real está
# protegido por Row Level Security (ver supabase/migrations/0002_rls_cafexis.sql).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
